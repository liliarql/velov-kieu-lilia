POSTGRES_PASSWORD=change-me
# PYTHON_IMAGE=python:3.12-slim
# TAG=dev

# S6 : mot de passe du compte admin de Grafana (compose.monitoring.yaml)
GRAFANA_ADMIN_PASSWORD=change-me
# S6 : à décommenter une fois les fichiers du TP6 récupérés, pour que toute commande
# docker compose (release.sh compris) lance les trois fichiers ensemble
# COMPOSE_FILE=compose.yaml:compose.mlflow.yaml:compose.monitoring.yaml
# S6 : mot de passe du rôle en lecture seule velov_ro (scripts/make_ro_role.sh), lu par velov.monitor
MONITOR_DB_PASSWORD=change-me
# S6 : adresse publique du service (IP de la VM, celle du certificat), pour Grafana sous /grafana/
PUBLIC_HOST=192.168.1.2xx
# S6 : authentification basique devant Prometheus (scripts/make_htpasswd.sh), 16 caractères minimum
PROMETHEUS_WEB_USER=velov
PROMETHEUS_WEB_PASSWORD=change-me
