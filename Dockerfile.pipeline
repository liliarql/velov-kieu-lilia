# Image du pipeline de données : collecte bronze (python -m velov.ingest) et dbt (silver, gold, tests).
ARG PYTHON_IMAGE=python:3.12-slim

FROM ${PYTHON_IMAGE}

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    DBT_PROFILES_DIR=/app/pipeline

RUN useradd --create-home --uid 10001 appuser

WORKDIR /app

COPY requirements-pipeline.txt .
RUN pip install -r requirements-pipeline.txt

COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-deps .

# dbt écrit target/ et logs/ dans le projet : le dossier appartient à l'utilisateur non root
COPY --chown=appuser:appuser pipeline/ pipeline/

USER appuser
WORKDIR /app/pipeline

CMD ["python", "-m", "velov.ingest", "--every", "900"]
